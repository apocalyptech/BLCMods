				<comment>py if hasattr(Mods, "SanitySaver"): unrealsdk.Log("         (Recommended to start at 30, though.)")</comment>
				<comment>py if hasattr(Mods, "SanitySaver"): unrealsdk.Log(" ")</comment>
				<comment>py if hasattr(Mods, "SanitySaver"): unrealsdk.Log("        -You get your first skill point at level 2, and stop getting skill points after level 69")</comment>
				<comment>py if hasattr(Mods, "SanitySaver"): unrealsdk.Log(" ")</comment>
				<comment>py if hasattr(Mods, "SanitySaver"): unrealsdk.Log("    If you experience any crashes, attempt to replicate them and compare them to vanilla.")</comment>
				<comment>py if hasattr(Mods, "SanitySaver"): unrealsdk.Log("    If they only continue with the mod on, please contact me about it")</comment>
				<comment>py if hasattr(Mods, "SanitySaver"): unrealsdk.Log("    (There is a wierd bug if you have BL2 Eternal turned on with adult varkid pods crashing your game)")</comment>
