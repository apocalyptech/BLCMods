							</hotfix>
							<hotfix name="Salvador" package="GD_Mercenary_Streaming">
								<code profiles="default">set GD_Mercenary_Skills.ActionSkill.Skill_Gunzerking InitialDuration 15.000000</code>
							</hotfix>
							<hotfix name="name" package="GD_Mercenary_Streaming">
