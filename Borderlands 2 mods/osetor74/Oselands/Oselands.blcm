											<code profiles="default">set GD_Weap_SniperRifles.FiringModes.Bullet_Sniper_Gubber NumRicochets 4</code>
											<code profiles="default">set GD_Weap_SniperRifles.FiringModes.Bullet_Sniper_Gubber Acceleration (X=0.000000,Y=0.000000,Z=-1000.000000)</code>
										</category>
										<category name="Title">
											<comment>clone -x GD_Weap_SniperRifles.Name.Title_Vladof.Title_Legendary_Lyudmila GD_Weap_SniperRifles.Name.Title_Vladof.Title_Legendary_Gubber</comment>
