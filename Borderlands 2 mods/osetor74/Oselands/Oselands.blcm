						<category name="Best Friends Forever">
							<hotfix name="OrderedChaos" package="GD_Tulip_Mechro_Streaming">
								<code profiles="default">set GD_Tulip_Mechromancer_Skills.SkillTrees.Branch_BestFriendsForever Tiers ((Skills=(SkillDefinition'GD_Tulip_Mechromancer_Skills.BestFriendsForever.PotentAsAPony',SkillDefinition'GD_Tulip_Mechromancer_Skills.BestFriendsForever.CookingUpTrouble'),PointsToUnlockNextTier=5),(Skills=(SkillDefinition'GD_Tulip_Mechromancer_Skills.BestFriendsForever.FancyMathematics',SkillDefinition'GD_Tulip_Mechromancer_Skills.EmbraceChaos.RobotRampage',SkillDefinition'GD_Tulip_Mechromancer_Skills.BestFriendsForever.TheBetterHalf'),PointsToUnlockNextTier=5),(Skills=(SkillDefinition'GD_Tulip_Mechromancer_Skills.BestFriendsForever.20PercentCooler',SkillDefinition'GD_Tulip_Mechromancer_Skills.BestFriendsForever.UpshotRobot',SkillDefinition'GD_Tulip_Mechromancer_Skills.BestFriendsForever.UnstoppableForce'),PointsToUnlockNextTier=5),(Skills=(SkillDefinition'GD_Tulip_Mechromancer_Skills.BestFriendsForever.ExplosiveClap',SkillDefinition'GD_Tulip_Mechromancer_Skills.BestFriendsForever.MadeOfSternerStuff'),PointsToUnlockNextTier=5),(Skills=(SkillDefinition'GD_Tulip_Mechromancer_Skills.BestFriendsForever.LazerDeathRobotLady'),PointsToUnlockNextTier=5),(Skills=(SkillDefinition'GD_Tulip_Mechromancer_Skills.BestFriendsForever.SharingIsCaring'),PointsToUnlockNextTier=1))</code>
								<code profiles="default">set GD_Tulip_Mechromancer_Skills.SkillTrees.Layout_BestFriendsForever Tiers ((bCellIsOccupied=(True,False,True)),(bCellIsOccupied=(True,True,True)),(bCellIsOccupied=(True,True,True)),(bCellIsOccupied=(True,True,False)),(bCellIsOccupied=(False,True,False)),(bCellIsOccupied=(False,True,False)))</code>
							</hotfix>
							<category name="Potent As a Pony">
