					<comment>pyb AID = unrealsdk.FindObject("AttributeInitializationDefinition", "Engine.Default__AttributeInitializationDefinition")</comment>
					<comment>pyb </comment>
					<comment>pyb def LoadTheBank(this: unrealsdk.UObject, function: unrealsdk.UFunction, params: unrealsdk.FStruct) -> bool:</comment>
					<comment>pyb     points_for_level = this.GetWillowGlobals().GetGlobalsDefinition().GeneralSkillPointsTotalForCurrentLevel</comment>
					<comment>pyb     max_points = int(AID.EvaluateInitializationData((points_for_level.BaseValueConstant,points_for_level.BaseValueAttribute,points_for_level.InitializationDefinition,points_for_level.BaseValueScaleConstant), this))</comment>
					<comment>pyb     spent_points = this.PlayerSkillTree.GetSkillPointsSpentInTree() if this.PlayerSkillTree is not None else 0</comment>
					<comment>pyb     if max_points != (this.PlayerReplicationInfo.GeneralSkillPoints + spent_points):</comment>
					<comment>pyb         this.PlayerReplicationInfo.GeneralSkillPoints = max_points - spent_points</comment>
					<comment>pyb     return True</comment>
					<comment>pyb </comment>
					<comment>pyb unrealsdk.RunHook("WillowGame.WillowPlayerController.LoadTheBank", "FixSkillPoints", LoadTheBank)</comment>
					<comment>pyb </comment>
					<comment>pyb def RequestSkillUpgrade(this: unrealsdk.UObject, function: unrealsdk.UFunction, params: unrealsdk.FStruct) -> bool:</comment>
					<comment>pyb     result = this.CanUpgradeSkill()</comment>
					<comment>pyb     result = 4 if result == 1 else result</comment>
					<comment>pyb     if result == 4:</comment>
					<comment>pyb         this.ProgressionMaskSpeed = this.MovieDef.BranchProgressionMaskSpeed</comment>
					<comment>pyb         this.WPCOwner.ServerUpgradeSkill(this.CurrentSkill)</comment>
					<comment>pyb         this.WPCOwner.PlayerSkillTree.UpdateBranchProgression(this)</comment>
					<comment>pyb     else:</comment>
					<comment>pyb         this.Movie.PlaySpecialUISound("ResultFailure")</comment>
					<comment>pyb     return False</comment>
					<comment>pyb </comment>
					<comment>pyb unrealsdk.RegisterHook("WillowGame.SkillTreeGFxObject.RequestSkillUpgrade", "FixSkillPoints", RequestSkillUpgrade)</comment>
					<comment>pyb </comment>
					<comment>pyb </comment>
					<comment>pyb def fake_level_five(this: unrealsdk.UObject, function: unrealsdk.UFunction, params: unrealsdk.FStruct) -> bool:</comment>
					<comment>pyb     func = getattr(this, function.Name)</comment>
					<comment>pyb     if this.WPCOwner.PlayerReplicationInfo.ExpLevel < 5:</comment>
					<comment>pyb         lvl = this.WPCOwner.PlayerReplicationInfo.ExpLevel</comment>
					<comment>pyb         this.WPCOwner.PlayerReplicationInfo.ExpLevel = 5</comment>
					<comment>pyb         func()</comment>
					<comment>pyb         this.WPCOwner.PlayerReplicationInfo.ExpLevel = lvl</comment>
					<comment>pyb         return False</comment>
					<comment>pyb     return True</comment>
					<comment>pyb </comment>
					<comment>pyb unrealsdk.RunHook("WillowGame.SkillTreeGFxObject.UpdateTooltips", "FixSkillPoints", fake_level_five)</comment>
					<comment>pyb unrealsdk.RunHook("WillowGame.SkillTreeGFxObject.UpdateInfoBox", "FixSkillPoints", fake_level_five)</comment>
					<comment>pyb unrealsdk.RunHook("WillowGame.SkillTreeGFxObject.UpdateAllSkillIcons", "FixSkillPoints", fake_level_five)</comment>
					<comment>pyb unrealsdk.RunHook("WillowGame.SkillTreeGFxObject.CalculateBranchProgression", "FixSkillPoints", fake_level_five)</comment>
					<comment>pyb -x</comment>
