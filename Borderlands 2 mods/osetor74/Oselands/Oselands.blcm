											<code profiles="default">set GD_Tulip_DeathTrap.Anims.Anim_DeathTrap_Frenzy_End PlayRate 1.500000</code>
											<code profiles="default">set GD_Tulip_DeathTrap.Melee.MeleeDef_DeathTrap_Frenzy DamageRadius 579.000000</code>
										</hotfix>
									</category>
									<category name="Explosive Clap">
										<comment>Removed the minimum distance for DT to be able to use the Explosive Clap.</comment>
										<comment>Increased the animation speed by 100%.</comment>
										<hotfix name="Hotfix" package="GD_Tulip_Mechro_Streaming">
											<code profiles="default">set GD_Tulip_DeathTrap.AI.WillowAIDef_DeathTrap:Action_FlyAnimAttack_27 bAttackFromOppositeSideOfMaster False</code>
											<code profiles="default">set GD_Tulip_DeathTrap.AI.WillowAIDef_DeathTrap:Action_FlyAnimAttack_27 Range (MinVal=0.000000,MaxVal=512.000000)</code>
											<code profiles="default">set GD_Tulip_DeathTrap.Anims.Anim_DeathTrap_ExplosiveClap PlayRate 1.500000</code>
										</hotfix>
									</category>
								</category>
								<category name="AI flags changes">
									<category name="New AI flags">
										<category name="FlagDefinition'GD_AI_Flags.Skills.Flag_Skills_EnableDeathTrapLaserBeam'  ">
											<comment>Can be added to an enemy's AIClassDefinition to force DT to only use his shock beam on them. Usefull for specific enemies he shoulden't attemp to melee.</comment>
											<comment>clone -x FlagDefinition'GearboxFramework.Default__FlagDefinition' FlagDefinition'GD_AI_Flags.Skills.Flag_Skills_EnableDeathTrapLaserBeam' </comment>
											<comment>clone -x WillowMindAttributeContextResolver'WillowGame.Default__WillowMindAttributeContextResolver' WillowMindAttributeContextResolver'GD_AI_Flags.Skills.Flag_Skills_EnableDeathTrapLaserBeam:WillowMindAttributeContextResolver_0'</comment>
											<comment>clone -x RuleEngineFlagValueResolver'GearboxFramework.Default__RuleEngineFlagValueResolver' RuleEngineFlagValueResolver'GD_AI_Flags.Skills.Flag_Skills_EnableDeathTrapLaserBeam:RuleEngineFlagValueResolver_0' </comment>
											<code profiles="default">set GD_AI_Flags.Skills.Flag_Skills_EnableDeathTrapLaserBeam ContextResolverChain (WillowMindAttributeContextResolver'GD_AI_Flags.Skills.Flag_Skills_EnableDeathTrapLaserBeam:WillowMindAttributeContextResolver_0')</code>
											<code profiles="default">set GD_AI_Flags.Skills.Flag_Skills_EnableDeathTrapLaserBeam ValueResolver RuleEngineFlagValueResolver'GD_AI_Flags.Skills.Flag_Skills_EnableDeathTrapLaserBeam:RuleEngineFlagValueResolver_0'</code>
										</category>
										<category name="FlagExpressionEvaluator'GD_Tulip_DeathTrap.Flags.Flag_TargetHasShockLaserOnThemEnabled' ">
											<comment>clone -x FlagExpressionEvaluator'GearboxFramework.Default__FlagExpressionEvaluator' FlagExpressionEvaluator'GD_Tulip_DeathTrap.Flags.Flag_TargetHasShockLaserOnThemEnabled'</comment>
											<code profiles="default">set FlagExpressionEvaluator'GD_Tulip_DeathTrap.Flags.Flag_TargetHasShockLaserOnThemEnabled' FlagChain ((FlagEvalType=FLAG_IsTrue,FlagDefinition=FlagDefinition'GD_AI_Flags.Skills.Flag_Skills_EnableDeathTrapLaserBeam',TimeSeconds=(BaseValueConstant=0.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)))</code>
										</category>
										<category name="FlagDefinition'GD_Tulip_DeathTrap.Flags.Flag_TargetHasShockLaserEnabled' ">
											<comment>clone -x FlagDefinition'GearboxFramework.Default__FlagDefinition' FlagDefinition'GD_Tulip_DeathTrap.Flags.Flag_TargetHasShockLaserEnabled'</comment>
											<comment>clone -x BestTargetAttributeContextResolver'GearboxFramework.Default__BestTargetAttributeContextResolver' BestTargetAttributeContextResolver'GD_Tulip_DeathTrap.Flags.Flag_TargetHasShockLaserEnabled:BestTargetAttributeContextResolver_0'</comment>
											<code profiles="default">set FlagDefinition'GD_Tulip_DeathTrap.Flags.Flag_TargetHasShockLaserEnabled' EvaluationExpression FlagExpressionEvaluator'GD_Tulip_DeathTrap.Flags.Flag_TargetHasShockLaserOnThemEnabled'</code>
											<code profiles="default">set FlagDefinition'GD_Tulip_DeathTrap.Flags.Flag_TargetHasShockLaserEnabled' ContextResolverChain (BestTargetAttributeContextResolver'GD_Tulip_DeathTrap.Flags.Flag_TargetHasShockLaserEnabled:BestTargetAttributeContextResolver_0')</code>
											<code profiles="default">set BestTargetAttributeContextResolver'GD_Tulip_DeathTrap.Flags.Flag_TargetHasShockLaserEnabled:BestTargetAttributeContextResolver_0' bGetTargetInfo False</code>
										</category>
									</category>
									<comment>Changed the flag for DT's shock beam to only target flying enemies or enemies with the new enabled laser flag.</comment>
									<hotfix name="Hotfix" package="GD_Tulip_Mechro_Streaming">
										<code profiles="default">set GD_Tulip_DeathTrap.AI.WillowAIDef_DeathTrap:FlagExpressionEvaluator_15 FlagChain ((FlagEvalType=FLAG_IsTrue,FlagDefinition=FlagDefinition'GD_Tulip_DeathTrap.Flags.Flag_TargetIsFlying',TimeSeconds=(BaseValueConstant=0.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)),(FlagEvalType=FLAG_IsTrue,FlagDefinition=FlagDefinition'GD_Tulip_DeathTrap.Flags.Flag_TargetHasShockLaserEnabled',TimeSeconds=(BaseValueConstant=0.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)))</code>
										<code profiles="default">set GD_Tulip_DeathTrap.AI.WillowAIDef_DeathTrap:FlagExpressionEvaluator_15 FlagChainOperator CEOP_Or</code>
									</hotfix>
								</category>
