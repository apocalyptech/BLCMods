<BLCMM v="1">
#<!!!You opened a file saved with BLCMM in FilterTool. Please update to BLCMM to properly open this file!!!>
	<head>
		<type name="BL2" offline="true"/>
		<profiles>
			<profile name="default" current="true"/>
		</profiles>
	</head>
	<body>
		<category name="Oselands">
			<comment>@title Oselands</comment>
			<comment>@main-author osetor74</comment>
			<comment>@author Temmmmy</comment>
			<comment>@version 1.2.6</comment>
			<comment>@description A large rework/rebalance of the game. Visit the GitHub page for more details.</comment>
			<comment>-</comment>
			<comment>Created by osetor74</comment>
			<comment></comment>
			<comment>  Additional help by Temmmmy and ZetaDaemon for contributions with code and advice with modding.</comment>
			<comment>  Playtesters: Viper, Temmmmy, neirax, Flynt/FlameTheGame, Funkotron9000, AnimaOmega</comment>
			<comment>               krzychhoo, Haderax, Pirek           ... oh yeah and also Doomatics</comment>
			<comment></comment>
			<comment></comment>
			<comment>This is a pseudo-modpack where i took aspects (mostly QoL) that i</comment>
			<comment>liked from other mods, including a large portion of the UCP,</comment>
			<comment>but pretty much all of the game balancing was done by me.</comment>
			<comment></comment>
			<comment>Changes game balance, weapon types, weapon/shield parts, unique weapons</comment>
			<comment>and some unique shields, character skill trees and class mods</comment>
			<comment>and more.</comment>
			<comment></comment>
			<comment>Requires Command Extensions, Sanity Saver, and thus also the PythonSDK to function properly</comment>
			<category name="Requirements Notification">
				<comment>CE_EnableOn Force</comment>
				<comment>suppress_next_chat "Error: This mod requires Command Extensions. A lot of things will not work properly without it."</comment>
				<comment>say Error: This mod requires Command Extensions. A lot of things will not work properly without it.</comment>
				<comment>py if not hasattr(Mods, "SanitySaver"): unrealsdk.GetEngine().GamePlayers[0].Actor.GetTextChatMovie().AddChatMessageInternal("[Oselands]", "Warning: this mod requires SanitySaver. Some items will not save properly without it.")</comment>
			</category>
			<comment>--------------------------------------------</comment>
			<category name="Remove base stat scaling past a level treshold">
				<category name="Attributes">
					<comment>clone -x DesignerAttributeDefinition'WillowGame.Default__DesignerAttributeDefinition' D_Attributes.GameplayAttributes.LevelScalingThreshold</comment>
					<comment>clone -x DesignerAttributeDefinition'WillowGame.Default__DesignerAttributeDefinition' D_Attributes.GameplayAttributes.LevelScalingThreshold_PlusOne</comment>
					<comment>clone -x AttributeInitializationDefinition'Engine.Default__AttributeInitializationDefinition' D_Attributes.GameplayAttributes.LevelScalingThreshold_PlusOneFormula</comment>
					<comment>clone -x AttributeInitializationDefinition'Engine.Default__AttributeInitializationDefinition' D_Attributes.GameplayAttributes.LevelScalingThreshold_XPMultiplierFormula</comment>
					<comment>clone -x DesignerAttributeDefinition'WillowGame.Default__DesignerAttributeDefinition' D_Attributes.GameplayAttributes.LevelScalingThreshold_XPMultiplier</comment>
					<comment>clone -x DesignerAttributeDefinition'WillowGame.Default__DesignerAttributeDefinition' D_Attributes.GameplayAttributes.PlayerGameStage</comment>
					<code profiles="default">set D_Attributes.GameplayAttributes.LevelScalingThreshold_PlusOne BaseValue (BaseValueConstant=0.000000,BaseValueAttribute=None,InitializationDefinition=AttributeInitializationDefinition'D_Attributes.GameplayAttributes.LevelScalingThreshold_PlusOneFormula',BaseValueScaleConstant=1.000000)</code>
					<code profiles="default">set D_Attributes.GameplayAttributes.LevelScalingThreshold_PlusOneFormula ValueFormula (bEnabled=True,Multiplier=(BaseValueConstant=1.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000),Level=(BaseValueConstant=0.000000,BaseValueAttribute=DesignerAttributeDefinition'D_Attributes.GameplayAttributes.LevelScalingThreshold',InitializationDefinition=None,BaseValueScaleConstant=1.000000),Power=(BaseValueConstant=1.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000),Offset=(BaseValueConstant=1.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000))</code>
					<code profiles="default">set D_Attributes.GameplayAttributes.LevelScalingThreshold_XPMultiplierFormula BaseValueMode BASEVALUE_InitializationDefScalesBaseValue</code>
					<code profiles="default">set D_Attributes.GameplayAttributes.LevelScalingThreshold_XPMultiplierFormula ConditionalInitialization (bEnabled=True,ConditionalExpressionList=((BaseValueIfTrue=(BaseValueConstant=1.000000,BaseValueAttribute=DesignerAttributeDefinition'D_Attributes.GameplayAttributes.LevelScalingThreshold_XPMultiplier',InitializationDefinition=None,BaseValueScaleConstant=1.000000),Expressions=((AttributeOperand1=AttributeDefinition'D_Attributes.ExperienceResourcePool.PlayerExperienceLevel_Sub',ComparisonOperator=OPERATOR_GreaterThanOrEqual,Operand2Usage=OPERAND_PreferAttribute,AttributeOperand2=DesignerAttributeDefinition'D_Attributes.GameplayAttributes.LevelScalingThreshold_PlusOne',ConstantOperand2=0.000000)))),DefaultBaseValue=(BaseValueConstant=1.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000))</code>
				</category>
				<category name="---- Customize Threshold Here, default 72 ----" MUT="true">
					<comment>Adjust the level threshold of when base stats stop scaling</comment>
					<comment>By default set to 72, meaning no base stat scales past level 72</comment>
					<comment>-</comment>
					<category name="Vanilla level 90 / OP10">
						<code profiles="">set D_Attributes.GameplayAttributes.LevelScalingThreshold BaseValue (BaseValueConstant=90.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)</code>
					</category>
					<category name="Level 80">
						<code profiles="">set D_Attributes.GameplayAttributes.LevelScalingThreshold BaseValue (BaseValueConstant=80.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)</code>
					</category>
					<category name="Level 72">
						<code profiles="">set D_Attributes.GameplayAttributes.LevelScalingThreshold BaseValue (BaseValueConstant=72.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)</code>
					</category>
					<category name="Level 69">
						<comment>Added because of the skill point limiter.</comment>
						<comment>Since you stop gaining skill points at level 69, so should items stop scaling as well.</comment>
						<comment>So that you are definitively  past the level progression, and the level only matters to get OP levels.</comment>
						<code profiles="default">set D_Attributes.GameplayAttributes.LevelScalingThreshold BaseValue (BaseValueConstant=69.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)</code>
					</category>
					<category name="Level 60">
						<code profiles="">set D_Attributes.GameplayAttributes.LevelScalingThreshold BaseValue (BaseValueConstant=60.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)</code>
					</category>
				</category>
				<category name="-- XP Multiplier After Threshold, default 3x --" MUT="true">
					<category name="0x if you really wanted to?">
						<code profiles="">set D_Attributes.GameplayAttributes.LevelScalingThreshold_XPMultiplier BaseValue (BaseValueConstant=0.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)</code>
					</category>
					<category name="1x">
						<code profiles="">set D_Attributes.GameplayAttributes.LevelScalingThreshold_XPMultiplier BaseValue (BaseValueConstant=1.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)</code>
					</category>
					<category name="1.5x">
						<code profiles="">set D_Attributes.GameplayAttributes.LevelScalingThreshold_XPMultiplier BaseValue (BaseValueConstant=1.500000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)</code>
					</category>
					<category name="2x">
						<code profiles="">set D_Attributes.GameplayAttributes.LevelScalingThreshold_XPMultiplier BaseValue (BaseValueConstant=2.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)</code>
					</category>
					<category name="3x">
						<code profiles="default">set D_Attributes.GameplayAttributes.LevelScalingThreshold_XPMultiplier BaseValue (BaseValueConstant=3.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)</code>
					</category>
					<category name="5x">
						<code profiles="">set D_Attributes.GameplayAttributes.LevelScalingThreshold_XPMultiplier BaseValue (BaseValueConstant=5.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)</code>
					</category>
					<category name="10x">
						<code profiles="">set D_Attributes.GameplayAttributes.LevelScalingThreshold_XPMultiplier BaseValue (BaseValueConstant=10.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)</code>
					</category>
				</category>
				<category name="Player">
					<comment>load_package GD_Siren_Streaming_SF</comment>
					<comment>clone -x GearboxFramework.Default__ConditionalAttributeValueResolver D_Attributes.ExperienceResourcePool.PlayerExperienceLevel_MaxThreshold</comment>
					<comment>clone -x D_Attributes.ExperienceResourcePool.PlayerExperienceLevel D_Attributes.ExperienceResourcePool.PlayerExperienceLevel_Sub</comment>
					<comment>clone -x GearboxFramework.Default__ConditionalAttributeValueResolver GD_Lobelia_GameStages.Attributes.GameStageViaGetGameStage_MaxThreshold</comment>
					<comment>clone -x GD_Lobelia_GameStages.Attributes.GameStageViaGetGameStage GD_Lobelia_GameStages.Attributes.GameStageViaGetGameStage_Sub</comment>
					<code profiles="default">set D_Attributes.ExperienceResourcePool.PlayerExperienceLevel ValueResolverChain (ConditionalAttributeValueResolver'D_Attributes.ExperienceResourcePool.PlayerExperienceLevel_MaxThreshold')</code>
					<code profiles="default">set D_Attributes.ExperienceResourcePool.PlayerExperienceLevel_MaxThreshold ValueExpressions (bEnabled=True,ConditionalExpressionList=((BaseValueIfTrue=(BaseValueConstant=0.000000,BaseValueAttribute=DesignerAttributeDefinition'D_Attributes.GameplayAttributes.LevelScalingThreshold',InitializationDefinition=None,BaseValueScaleConstant=1.000000),Expressions=((AttributeOperand1=AttributeDefinition'D_Attributes.ExperienceResourcePool.PlayerExperienceLevel_Sub',ComparisonOperator=OPERATOR_GreaterThanOrEqual,Operand2Usage=OPERAND_PreferAttribute,AttributeOperand2=DesignerAttributeDefinition'D_Attributes.GameplayAttributes.LevelScalingThreshold_PlusOne',ConstantOperand2=0.000000)))),DefaultBaseValue=(BaseValueConstant=0.000000,BaseValueAttribute=AttributeDefinition'D_Attributes.ExperienceResourcePool.PlayerExperienceLevel_Sub',InitializationDefinition=None,BaseValueScaleConstant=1.000000))</code>
					<code profiles="default">set GD_Lobelia_GameStages.Attributes.GameStageViaGetGameStage ValueResolverChain (ConditionalAttributeValueResolver'GD_Lobelia_GameStages.Attributes.GameStageViaGetGameStage_MaxThreshold')</code>
					<code profiles="default">set GD_Lobelia_GameStages.Attributes.GameStageViaGetGameStage_MaxThreshold ValueExpressions (bEnabled=True,ConditionalExpressionList=((BaseValueIfTrue=(BaseValueConstant=0.000000,BaseValueAttribute=DesignerAttributeDefinition'D_Attributes.GameplayAttributes.LevelScalingThreshold',InitializationDefinition=None,BaseValueScaleConstant=1.000000),Expressions=((AttributeOperand1=AttributeDefinition'GD_Lobelia_GameStages.Attributes.GameStageViaGetGameStage_Sub',ComparisonOperator=OPERATOR_GreaterThanOrEqual,Operand2Usage=OPERAND_PreferAttribute,AttributeOperand2=DesignerAttributeDefinition'D_Attributes.GameplayAttributes.LevelScalingThreshold_PlusOne',ConstantOperand2=0.000000)))),DefaultBaseValue=(BaseValueConstant=0.000000,BaseValueAttribute=AttributeDefinition'GD_Lobelia_GameStages.Attributes.GameStageViaGetGameStage_Sub',InitializationDefinition=None,BaseValueScaleConstant=1.000000))</code>
					<comment>-</comment>
					<code profiles="default">set GD_Balance_HealthAndDamage.HealthAndDamage.Init_PlayerHealth ValueFormula (bEnabled=True,Multiplier=(BaseValueConstant=1.000000,BaseValueAttribute=AttributeDefinition'GD_Balance_HealthAndDamage.HealthAndDamage.Att_UniversalBalanceMultiplier_HealthShields',InitializationDefinition=None,BaseValueScaleConstant=1.0000000),Level=(BaseValueConstant=0.000000,BaseValueAttribute=AttributeDefinition'GD_Balance_HealthAndDamage.HealthAndDamage.Att_UniversalBalanceScaler',InitializationDefinition=None,BaseValueScaleConstant=1.000000),Power=(BaseValueConstant=1.000000,BaseValueAttribute=AttributeDefinition'GD_Lobelia_GameStages.Attributes.GameStageViaGetGameStage',InitializationDefinition=None,BaseValueScaleConstant=1.000000),Offset=(BaseValueConstant=0.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000))</code>
					<hotfix name="Hotfix" level="None">
						<code profiles="">set GD_Balance_HealthAndDamage.HealthAndDamage.Init_PlayerMeleeDamageBase ValueFormula (bEnabled=True,Multiplier=(BaseValueConstant=8.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000),Level=(BaseValueConstant=0.000000,BaseValueAttribute=AttributeDefinition'GD_Balance_HealthAndDamage.HealthAndDamage.Att_UniversalBalanceScaler',InitializationDefinition=None,BaseValueScaleConstant=1.000000),Power=(BaseValueConstant=0.000000,BaseValueAttribute=AttributeDefinition'GD_Lobelia_GameStages.Attributes.GameStageViaGetGameStage',InitializationDefinition=None,BaseValueScaleConstant=1.000000),Offset=(BaseValueConstant=0.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000))</code>
						<code profiles="">set GD_Balance_HealthAndDamage.HealthAndDamage.Init_PlayerSkillStatusEffectDamage ValueFormula (bEnabled=True,Multiplier=(BaseValueConstant=9.500000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000),Level=(BaseValueConstant=0.000000,BaseValueAttribute=AttributeDefinition'GD_Balance_HealthAndDamage.HealthAndDamage.Att_UniversalBalanceScaler',InitializationDefinition=None,BaseValueScaleConstant=1.000000),Power=(BaseValueConstant=0.000000,BaseValueAttribute=AttributeDefinition'GD_Lobelia_GameStages.Attributes.GameStageViaGetGameStage',InitializationDefinition=None,BaseValueScaleConstant=1.000000),Offset=(BaseValueConstant=0.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000))</code>
						<code profiles="">set GD_Balance_HealthAndDamage.Init_PlayerSkillDamage_Part2 ValueFormula (bEnabled=True,Multiplier=(BaseValueConstant=8.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000),Level=(BaseValueConstant=0.000000,BaseValueAttribute=AttributeDefinition'GD_Balance_HealthAndDamage.HealthAndDamage.Att_UniversalBalanceScaler',InitializationDefinition=None,BaseValueScaleConstant=1.000000),Power=(BaseValueConstant=0.000000,BaseValueAttribute=AttributeDefinition'GD_Lobelia_GameStages.Attributes.GameStageViaGetGameStage',InitializationDefinition=None,BaseValueScaleConstant=1.000000),Offset=(BaseValueConstant=0.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000))</code>
						<code profiles="">set GD_Balance_HealthAndDamage.Init_PlayerSkillDamage_AdditionalDamagePerLvl ValueFormula (bEnabled=True,Multiplier=(BaseValueConstant=1.000000,BaseValueAttribute=AttributeDefinition'GD_Balance_HealthAndDamage.HealthAndDamage.Att_UniversalAdditionalEnemyHealthPerLvl',InitializationDefinition=None,BaseValueScaleConstant=1.000000),Level=(BaseValueConstant=0.000000,BaseValueAttribute=AttributeDefinition'GD_Lobelia_GameStages.Attributes.GameStageViaGetGameStage',InitializationDefinition=None,BaseValueScaleConstant=1.000000),Power=(BaseValueConstant=1.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000),Offset=(BaseValueConstant=0.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000))</code>
						<code profiles="">set GD_Attributes_Lilac.Init_PlayerSkillDamage_AdditionalDamagePerLvl ValueFormula (bEnabled=True,Multiplier=(BaseValueConstant=1.000000,BaseValueAttribute=AttributeDefinition'GD_Balance_HealthAndDamage.HealthAndDamage.Att_UniversalAdditionalEnemyHealthPerLvl',InitializationDefinition=None,BaseValueScaleConstant=1.000000),Level=(BaseValueConstant=0.000000,BaseValueAttribute=AttributeDefinition'GD_Lobelia_GameStages.Attributes.GameStageViaGetGameStage',InitializationDefinition=None,BaseValueScaleConstant=1.000000),Power=(BaseValueConstant=1.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000),Offset=(BaseValueConstant=0.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000))</code>
						<code profiles="">set GD_Attributes_Lilac.Init_PlayerSkillDamage_Part2 ValueFormula (bEnabled=True,Multiplier=(BaseValueConstant=8.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000),Level=(BaseValueConstant=0.000000,BaseValueAttribute=AttributeDefinition'GD_Balance_HealthAndDamage.HealthAndDamage.Att_UniversalBalanceScaler',InitializationDefinition=None,BaseValueScaleConstant=1.000000),Power=(BaseValueConstant=0.000000,BaseValueAttribute=AttributeDefinition'GD_Lobelia_GameStages.Attributes.GameStageViaGetGameStage',InitializationDefinition=None,BaseValueScaleConstant=1.000000),Offset=(BaseValueConstant=0.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000))</code>
						<code profiles="">set GD_Lilac_Skills_Bloodlust.Attributes.Init_BloodsplosionNovaStatusDamage ValueFormula (bEnabled=True,Multiplier=(BaseValueConstant=20.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000),Level=(BaseValueConstant=0.000000,BaseValueAttribute=AttributeDefinition'GD_Balance_HealthAndDamage.HealthAndDamage.Att_UniversalBalanceScaler',InitializationDefinition=None,BaseValueScaleConstant=1.000000),Power=(BaseValueConstant=0.000000,BaseValueAttribute=AttributeDefinition'GD_Lobelia_GameStages.Attributes.GameStageViaGetGameStage',InitializationDefinition=None,BaseValueScaleConstant=1.000000),Offset=(BaseValueConstant=0.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000))</code>
					</hotfix>
				</category>
				<category name="Enemy">
					<comment>clone -x GearboxFramework.Default__ConditionalAttributeValueResolver D_Attributes.AI.AICharacterExperienceLevel_MaxThreshold</comment>
