					<category name="Class Mod skill UI">
						<category name="Slag Damage UI">
							<comment>clone -x GD_AttributePresentation.ClassMods_Only.AttrPresent_WeaponDamage GD_AttributePresentation.ClassMods_Only.AttrPresent_SlagDamage</comment>
