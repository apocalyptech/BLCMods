					<category name="Add new class mods to drop pools">
						<code profiles="default">set GD_ItemGrades.ClassMods.BalDef_ClassMod_Mercenary ClassModDefinitions (ClassModDefinition'GD_ClassMods.A_Item_Merc.ClassMod_Merc_Beast',ClassModDefinition'GD_ClassMods.A_Item_Merc.ClassMod_Merc_Berserker',ClassModDefinition'GD_ClassMods.A_Item_Merc.ClassMod_Merc_Wardog',ClassModDefinition'GD_ClassMods.A_Item_Merc.ClassMod_Merc_Devastator',ClassModDefinition'GD_ClassMods.A_Item_Merc.ClassMod_Merc_Raider',ClassModDefinition'GD_ClassMods.A_Item_Merc.ClassMod_Merc_Renegade',ClassModDefinition'GD_ClassMods.A_Item_Merc.ClassMod_Merc_Tank',ClassModDefinition'GD_ClassMods.A_Item_Merc.ClassMod_Merc_Titan',ClassModDefinition'GD_ClassMods.A_Item_Merc.ClassMod_Merc_Hoarder',ClassModDefinition'GD_ClassMods.A_Item_Merc.ClassMod_Merc_Machine')</code>
