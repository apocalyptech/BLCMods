					<comment>clone -x D_Attributes.GrenadeMod.GrenadeModItemLevel D_Attributes.GrenadeMod.GrenadeModItemLevel_Sub</comment>
					<code profiles="default">set D_Attributes.GrenadeMod.GrenadeModItemLevel ValueResolverChain (ConditionalAttributeValueResolver'D_Attributes.GrenadeMod.GrenadeModItemLevel_MaxTreshold')</code>
					<code profiles="default">set D_Attributes.GrenadeMod.GrenadeModItemLevel_MaxTreshold ValueExpressions (bEnabled=True,ConditionalExpressionList=((BaseValueIfTrue=(BaseValueConstant=0.000000,BaseValueAttribute=DesignerAttributeDefinition'D_Attributes.GameplayAttributes.LevelScalingThreshold',InitializationDefinition=None,BaseValueScaleConstant=1.000000),Expressions=((AttributeOperand1=AttributeDefinition'D_Attributes.GrenadeMod.GrenadeModItemLevel_Sub',ComparisonOperator=OPERATOR_GreaterThanOrEqual,Operand2Usage=OPERAND_PreferAttribute,AttributeOperand2=DesignerAttributeDefinition'D_Attributes.GameplayAttributes.LevelScalingThreshold_PlusOne',ConstantOperand2=0.000000)))),DefaultBaseValue=(BaseValueConstant=0.000000,BaseValueAttribute=AttributeDefinition'D_Attributes.GrenadeMod.GrenadeModItemLevel_Sub',InitializationDefinition=None,BaseValueScaleConstant=1.000000))</code>
					<comment>-</comment>
					<comment>clone -x GearboxFramework.Default__ConditionalAttributeValueResolver D_Attributes.Projectile.ProjectileLevel_MaxThreshold</comment>
					<comment>clone -x D_Attributes.Inventory.ShieldItemLevel D_Attributes.Projectile.ProjectileLevel_Sub</comment>
					<code profiles="default">set D_Attributes.Projectile.ProjectileLevel ValueResolverChain (ConditionalAttributeValueResolver'D_Attributes.Projectile.ProjectileLevel_MaxThreshold')</code>
					<code profiles="default">set D_Attributes.Projectile.ProjectileLevel_MaxThreshold ValueExpressions (bEnabled=True,ConditionalExpressionList=((BaseValueIfTrue=(BaseValueConstant=0.000000,BaseValueAttribute=DesignerAttributeDefinition'D_Attributes.GameplayAttributes.LevelScalingThreshold',InitializationDefinition=None,BaseValueScaleConstant=1.000000),Expressions=((AttributeOperand1=AttributeDefinition'D_Attributes.Projectile.ProjectileLevel_Sub',ComparisonOperator=OPERATOR_GreaterThanOrEqual,Operand2Usage=OPERAND_PreferAttribute,AttributeOperand2=DesignerAttributeDefinition'D_Attributes.GameplayAttributes.LevelScalingThreshold_PlusOne',ConstantOperand2=0.000000)))),DefaultBaseValue=(BaseValueConstant=0.000000,BaseValueAttribute=AttributeDefinition'D_Attributes.Projectile.ProjectileLevel_Sub',InitializationDefinition=None,BaseValueScaleConstant=1.000000))</code>
				</category>
				<category name="Class Mod">
					<comment>clone -x GearboxFramework.Default__ConditionalAttributeValueResolver D_Attributes.Inventory.ClassModItemLevel_MaxThreshold</comment>
					<comment>clone -x D_Attributes.Inventory.ShieldItemLevel D_Attributes.Inventory.ClassModItemLevel_Sub</comment>
					<code profiles="default">set D_Attributes.Inventory.ClassModItemLevel ValueResolverChain (ConditionalAttributeValueResolver'D_Attributes.Inventory.ClassModItemLevel_MaxThreshold')</code>
					<code profiles="default">set D_Attributes.Inventory.ClassModItemLevel_MaxThreshold ValueExpressions (bEnabled=True,ConditionalExpressionList=((BaseValueIfTrue=(BaseValueConstant=0.000000,BaseValueAttribute=DesignerAttributeDefinition'D_Attributes.GameplayAttributes.LevelScalingThreshold',InitializationDefinition=None,BaseValueScaleConstant=1.000000),Expressions=((AttributeOperand1=AttributeDefinition'D_Attributes.Inventory.ClassModItemLevel_Sub',ComparisonOperator=OPERATOR_GreaterThanOrEqual,Operand2Usage=OPERAND_PreferAttribute,AttributeOperand2=DesignerAttributeDefinition'D_Attributes.GameplayAttributes.LevelScalingThreshold_PlusOne',ConstantOperand2=0.000000)))),DefaultBaseValue=(BaseValueConstant=0.000000,BaseValueAttribute=AttributeDefinition'D_Attributes.Inventory.ClassModItemLevel_Sub',InitializationDefinition=None,BaseValueScaleConstant=1.000000))</code>
				</category>
				<category name="Relic">
					<comment>clone -x GearboxFramework.Default__ConditionalAttributeValueResolver D_Attributes.Inventory.ArtifactItemLevel_MaxTreshold</comment>
					<comment>clone -x D_Attributes.Inventory.ArtifactItemLevel D_Attributes.Inventory.ArtifactItemLevel_Sub</comment>
