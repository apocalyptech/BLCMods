					<category name="Remove skill point variation on purple rarity class mods">
						<comment>Makes it so purple rarity class mods are always 5/4/4 instead of</comment>
						<comment>having the chance for 5/4/3 and 5/3/4 as well</comment>
						<code profiles="default">set GD_ClassMods.Specialization.Spec_AS1_BS2_-CS3 AttributeSlotUpgrades ((SlotName="Skill1",GradeIncrease=3,bActivateSlot=True),(SlotName="Skill2",GradeIncrease=0,bActivateSlot=True),(SlotName="Skill3",GradeIncrease=0,bActivateSlot=True))</code>
						<code profiles="default">set GD_ClassMods.Specialization.Spec_AS1_-BS2_CS3 AttributeSlotUpgrades ((SlotName="Skill1",GradeIncrease=3,bActivateSlot=True),(SlotName="Skill2",GradeIncrease=0,bActivateSlot=True),(SlotName="Skill3",GradeIncrease=0,bActivateSlot=True))</code>
