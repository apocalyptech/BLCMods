									<code profiles="default">set GD_LootMidget_LoaderJET.Character.Pawn_LootMidget_LoaderJET ActorSpawnCost 0</code>
									<code profiles="default">set GD_LootMidget_LoaderWAR.Character.Pawn_LootMidget_LoaderWAR ActorSpawnCost 0</code>
									<code profiles="default">set GD_LootMidget_Marauder.Character.Pawn_LootMidget_Marauder ActorSpawnCost 0</code>
								</hotfix>
							</category>
