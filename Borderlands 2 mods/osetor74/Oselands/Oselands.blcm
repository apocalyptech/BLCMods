					<code profiles="default">set D_Attributes.AI.AICharacterExperienceLevel ValueResolverChain (ConditionalAttributeValueResolver'D_Attributes.AI.AICharacterExperienceLevel_MaxThreshold')</code>
					<code profiles="default">set D_Attributes.AI.AICharacterExperienceLevel_MaxThreshold ValueExpressions (bEnabled=True,ConditionalExpressionList=((BaseValueIfTrue=(BaseValueConstant=0.000000,BaseValueAttribute=DesignerAttributeDefinition'D_Attributes.GameplayAttributes.LevelScalingThreshold',InitializationDefinition=None,BaseValueScaleConstant=1.000000),Expressions=((AttributeOperand1=AttributeDefinition'D_Attributes.AI.AICharacterExperienceLevel_Sub',ComparisonOperator=OPERATOR_GreaterThanOrEqual,Operand2Usage=OPERAND_PreferAttribute,AttributeOperand2=DesignerAttributeDefinition'D_Attributes.GameplayAttributes.LevelScalingThreshold_PlusOne',ConstantOperand2=0.000000)))),DefaultBaseValue=(BaseValueConstant=0.000000,BaseValueAttribute=AttributeDefinition'D_Attributes.AI.AICharacterExperienceLevel_Sub',InitializationDefinition=None,BaseValueScaleConstant=1.000000))</code>
				</category>
				<category name="Gun">
					<comment>clone -x GearboxFramework.Default__ConditionalAttributeValueResolver D_Attributes.Weapon.WeaponLevel_MaxThreshold</comment>
					<comment>clone -x D_Attributes.Weapon.WeaponLevel D_Attributes.Weapon.WeaponLevel_Sub</comment>
					<code profiles="default">set D_Attributes.Weapon.WeaponLevel ValueResolverChain (ConditionalAttributeValueResolver'D_Attributes.Weapon.WeaponLevel_MaxThreshold')</code>
					<code profiles="default">set D_Attributes.Weapon.WeaponLevel_MaxThreshold ValueExpressions (bEnabled=True,ConditionalExpressionList=((BaseValueIfTrue=(BaseValueConstant=0.000000,BaseValueAttribute=DesignerAttributeDefinition'D_Attributes.GameplayAttributes.LevelScalingThreshold',InitializationDefinition=None,BaseValueScaleConstant=1.000000),Expressions=((AttributeOperand1=AttributeDefinition'D_Attributes.Weapon.WeaponLevel_Sub',ComparisonOperator=OPERATOR_GreaterThanOrEqual,Operand2Usage=OPERAND_PreferAttribute,AttributeOperand2=DesignerAttributeDefinition'D_Attributes.GameplayAttributes.LevelScalingThreshold_PlusOne',ConstantOperand2=0.000000)))),DefaultBaseValue=(BaseValueConstant=0.000000,BaseValueAttribute=AttributeDefinition'D_Attributes.Weapon.WeaponLevel_Sub',InitializationDefinition=None,BaseValueScaleConstant=1.000000))</code>
				</category>
				<category name="Shield">
					<comment>clone -x GearboxFramework.Default__ConditionalAttributeValueResolver D_Attributes.Inventory.ShieldItemLevel_MaxTreshold</comment>
					<comment>clone -x D_Attributes.Inventory.ShieldItemLevel D_Attributes.Inventory.ShieldItemLevel_Sub</comment>
					<code profiles="default">set D_Attributes.Inventory.ShieldItemLevel ValueResolverChain (ConditionalAttributeValueResolver'D_Attributes.Inventory.ShieldItemLevel_MaxTreshold')</code>
					<code profiles="default">set D_Attributes.Inventory.ShieldItemLevel_MaxTreshold ValueExpressions (bEnabled=True,ConditionalExpressionList=((BaseValueIfTrue=(BaseValueConstant=0.000000,BaseValueAttribute=DesignerAttributeDefinition'D_Attributes.GameplayAttributes.LevelScalingThreshold',InitializationDefinition=None,BaseValueScaleConstant=1.000000),Expressions=((AttributeOperand1=AttributeDefinition'D_Attributes.Inventory.ShieldItemLevel_Sub',ComparisonOperator=OPERATOR_GreaterThanOrEqual,Operand2Usage=OPERAND_PreferAttribute,AttributeOperand2=DesignerAttributeDefinition'D_Attributes.GameplayAttributes.LevelScalingThreshold_PlusOne',ConstantOperand2=0.000000)))),DefaultBaseValue=(BaseValueConstant=0.000000,BaseValueAttribute=AttributeDefinition'D_Attributes.Inventory.ShieldItemLevel_Sub',InitializationDefinition=None,BaseValueScaleConstant=1.000000))</code>
