			<category name="Quest Changes">
				<category name="Make every round of the Slaughters repeatable after completing them once">
					<comment>Makes each round of the slaughters repeatable</comment>
					<comment>Taken initially from UCP, tweaked to include every other round as well</comment>
					<category name="Bandit Slaughter">
						<code profiles="default">set GD_Z1_BanditSlaughter.M_BanditSlaughter1 bRepeatable True</code>
						<code profiles="default">set GD_Z1_BanditSlaughter.M_BanditSlaughter2 bRepeatable True</code>
						<code profiles="default">set GD_Z1_BanditSlaughter.M_BanditSlaughter3 bRepeatable True</code>
						<code profiles="default">set GD_Z1_BanditSlaughter.M_BanditSlaughter4 bRepeatable True</code>
						<code profiles="default">set GD_Z1_BanditSlaughter.M_BanditSlaughter5 bRepeatable True</code>
					</category>
					<category name="Creature Slaughter">
						<code profiles="default">set GD_Z2_CreatureSlaughter.M_CreatureSlaughter_1 bRepeatable True</code>
						<code profiles="default">set GD_Z2_CreatureSlaughter.M_CreatureSlaughter_2 bRepeatable True</code>
						<code profiles="default">set GD_Z2_CreatureSlaughter.M_CreatureSlaughter_3 bRepeatable True</code>
						<code profiles="default">set GD_Z2_CreatureSlaughter.M_CreatureSlaughter_4 bRepeatable True</code>
						<code profiles="default">set GD_Z2_CreatureSlaughter.M_CreatureSlaughter_5 bRepeatable True</code>
					</category>
					<category name="Robot Slaughter">
						<code profiles="default">set GD_Z3_RobotSlaughter.M_RobotSlaughter_1 bRepeatable True</code>
						<code profiles="default">set GD_Z3_RobotSlaughter.M_RobotSlaughter_2 bRepeatable True</code>
						<code profiles="default">set GD_Z3_RobotSlaughter.M_RobotSlaughter_3 bRepeatable True</code>
						<code profiles="default">set GD_Z3_RobotSlaughter.M_RobotSlaughter_4 bRepeatable True</code>
						<code profiles="default">set GD_Z3_RobotSlaughter.M_RobotSlaughter_5 bRepeatable True</code>
					</category>
				</category>
				<category name="Increase the XP reward of Cleaning Up The Burg">
					<hotfix name="Hotfix" level="SouthernShelf_P">
						<code profiles="default">set GD_Episode02.M_Ep2a_MoreGuns Reward.ExperienceRewardPercentage (BaseValueConstant=0.100000,BaseValueAttribute=AttributeDefinition'GD_MissionRewardBalance.XP.XPReward_05_Largest',InitializationDefinition=None,BaseValueScaleConstant=2.500000)</code>
					</hotfix>
				</category>
				<category name="Make the final mission of the FFS campaign give a random blue/purple relic instead">
					<hotfix name="Hotfix" level="None">
						<code profiles="default">set GD_Anemone_Plot_Mission060.M_Anemone_PlotMission060 Reward.RewardItemPools (ItemPoolDefinition'GD_Itempools.Treasure_ChestPools.Pool_EpicChest_Artifacts')</code>
					</hotfix>
				</category>
				<category name="Move Sand Hawk from Whoops to Treasure of the Sands, and make Whoops give a random purple gun">
					<hotfix name="Hotfix" level="None">
						<code profiles="default">set GD_Orchid_SM_EndGameClone.M_Orchid_EndGame Reward (ExperienceRewardPercentage=(BaseValueConstant=0.100000,BaseValueAttribute=AttributeDefinition'GD_MissionRewardBalance.XP.XPReward_03_Medium',InitializationDefinition=None,BaseValueScaleConstant=1.000000),CurrencyRewardType=CURRENCY_Credits,CreditRewardMultiplier=(BaseValueConstant=0.000000,BaseValueAttribute=AttributeDefinition'GD_MissionRewardBalance.Cash.CashReward_03_Medium',InitializationDefinition=None,BaseValueScaleConstant=1.000000),OtherCurrencyReward=(BaseValueConstant=0.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000),RewardItems=(WeaponBalanceDefinition'GD_Orchid_BossWeapons.SMG.SMG_Dahl_3_SandHawk'),RewardItemPools=)</code>
						<code profiles="default">set GD_Orchid_Plot_Mission07.M_Orchid_PlotMission07 Reward (ExperienceRewardPercentage=(BaseValueConstant=0.100000,BaseValueAttribute=AttributeDefinition'GD_Orchid_GameStages.XPBalance.XPReward_03_Medium_Orchid',InitializationDefinition=None,BaseValueScaleConstant=1.000000),CurrencyRewardType=CURRENCY_Credits,CreditRewardMultiplier=(BaseValueConstant=1.000000,BaseValueAttribute=AttributeDefinition'GD_MissionRewardBalance.Cash.CashReward_03_Medium',InitializationDefinition=None,BaseValueScaleConstant=1.000000),OtherCurrencyReward=(BaseValueConstant=0.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000),RewardItems=,RewardItemPools=(ItemPoolDefinition'GD_Itempools.WeaponPools.Pool_Weapons_All_05_VeryRare'))</code>
					</hotfix>
				</category>
				<category name="Make Master Gee's quest be completable without completing Hyperius's">
					<hotfix name="Hotfix" level="None">
						<code profiles="default">set GD_Orchid_Raid.M_Orchid_Raid3 Dependencies (MissionDefinition'GD_Orchid_Plot_Mission09.M_Orchid_PlotMission09')</code>
					</hotfix>
				</category>
			</category>
			<comment>---</comment>
			<category name="Fight For Sanctuary Toggle (TURN THIS ON IF YOU DON'T HAVE THE DLC)">
				<comment>Removes FFS items from world drop pools, reverting Oselands changes</comment>
