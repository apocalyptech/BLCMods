					<code profiles="default">set D_Attributes.Inventory.ArtifactItemLevel_MaxTreshold ValueExpressions (bEnabled=True,ConditionalExpressionList=((BaseValueIfTrue=(BaseValueConstant=0.000000,BaseValueAttribute=DesignerAttributeDefinition'D_Attributes.GameplayAttributes.LevelScalingThreshold',InitializationDefinition=None,BaseValueScaleConstant=1.000000),Expressions=((AttributeOperand1=AttributeDefinition'D_Attributes.Inventory.ArtifactItemLevel_Sub',ComparisonOperator=OPERATOR_GreaterThanOrEqual,Operand2Usage=OPERAND_PreferAttribute,AttributeOperand2=DesignerAttributeDefinition'D_Attributes.GameplayAttributes.LevelScalingThreshold_PlusOne',ConstantOperand2=0.000000)))),DefaultBaseValue=(BaseValueConstant=0.000000,BaseValueAttribute=AttributeDefinition'D_Attributes.Inventory.ArtifactItemLevel_Sub',InitializationDefinition=None,BaseValueScaleConstant=1.000000))</code>
				</category>
				<category name="Environmental Damage">
					<code profiles="default">set GD_Explosives.Barrels.Init_BarrelDamage ValueFormula (bEnabled=True,Multiplier=(BaseValueConstant=20.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000),Level=(BaseValueConstant=0.000000,BaseValueAttribute=AttributeDefinition'GD_Balance_HealthAndDamage.HealthAndDamage.Att_UniversalBalanceScaler',InitializationDefinition=None,BaseValueScaleConstant=1.000000),Power=(BaseValueConstant=0.000000,BaseValueAttribute=AttributeDefinition'D_Attributes.ExperienceResourcePool.PlayerExperienceLevel',InitializationDefinition=None,BaseValueScaleConstant=1.000000),Offset=(BaseValueConstant=0.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000))</code>
					<comment>-</comment>
					<hotfix name="Hotfix" level="None">
						<code profiles="default">set GD_Balance_HealthAndDamage.HealthAndDamage.Init_VolumeStatusEffectDamage ValueFormula (bEnabled=True,Multiplier=(BaseValueConstant=0.000000,BaseValueAttribute=DesignerAttributeDefinition'GD_Balance_HealthAndDamage.DamageMultipliers.Attribute_VolumeStatusEffectDamageMultiplier',InitializationDefinition=None,BaseValueScaleConstant=16.000000),Level=(BaseValueConstant=0.000000,BaseValueAttribute=AttributeDefinition'GD_Balance_HealthAndDamage.HealthAndDamage.Att_UniversalBalanceScaler',InitializationDefinition=None,BaseValueScaleConstant=1.000000),Power=(BaseValueConstant=0.000000,BaseValueAttribute=AttributeDefinition'D_Attributes.Balance.BehaviorVolumeLevel',InitializationDefinition=None,BaseValueScaleConstant=1.000000),Offset=(BaseValueConstant=0.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000))</code>
					</hotfix>
					<comment>clone -x D_Attributes.Balance.GameStage D_Attributes.Balance.BehaviorVolumeLevel</comment>
					<comment>clone -x GearboxFramework.Default__ConditionalAttributeValueResolver D_Attributes.Balance.BehaviorVolumeLevel_MaxThreshold</comment>
					<comment>clone -x D_Attributes.Balance.GameStage D_Attributes.Balance.BehaviorVolumeLevel_Sub</comment>
					<code profiles="default">set D_Attributes.Balance.BehaviorVolumeLevel AttributeDataType ADT_Float</code>
					<code profiles="default">set D_Attributes.Balance.BehaviorVolumeLevel ValueResolverChain (ConditionalAttributeValueResolver'D_Attributes.Balance.BehaviorVolumeLevel_MaxThreshold')</code>
					<code profiles="default">set D_Attributes.Balance.BehaviorVolumeLevel_MaxThreshold ValueExpressions (bEnabled=True,ConditionalExpressionList=((BaseValueIfTrue=(BaseValueConstant=0.000000,BaseValueAttribute=DesignerAttributeDefinition'D_Attributes.GameplayAttributes.LevelScalingThreshold',InitializationDefinition=None,BaseValueScaleConstant=1.000000),Expressions=((AttributeOperand1=AttributeDefinition'D_Attributes.Balance.BehaviorVolumeLevel_Sub',ComparisonOperator=OPERATOR_GreaterThanOrEqual,Operand2Usage=OPERAND_PreferAttribute,AttributeOperand2=DesignerAttributeDefinition'D_Attributes.GameplayAttributes.LevelScalingThreshold_PlusOne',ConstantOperand2=0.000000)))),DefaultBaseValue=(BaseValueConstant=0.000000,BaseValueAttribute=AttributeDefinition'D_Attributes.Balance.BehaviorVolumeLevel_Sub',InitializationDefinition=None,BaseValueScaleConstant=1.000000))</code>
					<code profiles="default">set D_Attributes.Balance.BehaviorVolumeLevel_Sub AttributeDataType ADT_Float</code>
				</category>
				<category name="Vehicle">
					<comment>clone -x D_Attributes.ExperienceResourcePool.PlayerExperienceLevel D_Attributes.ExperienceResourcePool.VehicleLevel</comment>
					<comment>clone -x GearboxFramework.Default__ConditionalAttributeValueResolver D_Attributes.ExperienceResourcePool.VehicleLevel_MaxTreshold</comment>
					<hotfix name="Hotfix" level="None">
						<code profiles="default">set GD_Balance_HealthAndDamage.HealthAndDamage.Init_VehicleDamage ValueFormula.Power.BaseValueAttribute AttributeDefinition'D_Attributes.ExperienceResourcePool.VehicleLevel'</code>
						<code profiles="default">set GD_Balance_HealthAndDamage.HealthAndDamage.Init_VehicleHealth ValueFormula.Power.BaseValueAttribute AttributeDefinition'D_Attributes.ExperienceResourcePool.VehicleLevel'</code>
						<code profiles="default">set GD_BanditTechnical.HealthMultipliers.Init_BaseEnemyVehicleHealth ValueFormula.Power.BaseValueAttribute AttributeDefinition'D_Attributes.ExperienceResourcePool.VehicleLevel'</code>
						<code profiles="default">set GD_BanditTechnical.HealthMultipliers.Init_EnemyVehicleHealth_AdditionalHealthPerLvl ValueFormula.Level.BaseValueAttribute AttributeDefinition'D_Attributes.ExperienceResourcePool.VehicleLevel'</code>
						<code profiles="default">set D_Attributes.ExperienceResourcePool.VehicleLevel ContextResolverChain (VehicleAttributeContextResolver'D_Attributes.Vehicle.VehicleLevel:VehicleAttributeContextResolver_0')</code>
					</hotfix>
					<code profiles="default">set D_Attributes.ExperienceResourcePool.VehicleLevel ValueResolverChain (ConditionalAttributeValueResolver'D_Attributes.ExperienceResourcePool.VehicleLevel_MaxTreshold')</code>
					<hotfix name="Hotfix" level="None">
						<code profiles="default">set D_Attributes.ExperienceResourcePool.VehicleLevel_MaxTreshold ValueExpressions (bEnabled=True,ConditionalExpressionList=((BaseValueIfTrue=(BaseValueConstant=0.000000,BaseValueAttribute=DesignerAttributeDefinition'D_Attributes.GameplayAttributes.LevelScalingThreshold',InitializationDefinition=None,BaseValueScaleConstant=1.000000),Expressions=((AttributeOperand1=AttributeDefinition'D_Attributes.Vehicle.VehicleLevel',ComparisonOperator=OPERATOR_GreaterThanOrEqual,Operand2Usage=OPERAND_PreferAttribute,AttributeOperand2=DesignerAttributeDefinition'D_Attributes.GameplayAttributes.LevelScalingThreshold_PlusOne',ConstantOperand2=0.000000)))),DefaultBaseValue=(BaseValueConstant=0.000000,BaseValueAttribute=AttributeDefinition'D_Attributes.Vehicle.VehicleLevel',InitializationDefinition=None,BaseValueScaleConstant=1.000000))</code>
					</hotfix>
				</category>
			</category>
			<category name="Dedicated Legendary Chance customization" MUT="true">
				<comment>NOTE: With certain enemies that have high enough amount of dedicated drops</comment>
				<comment>      they can exceed the 100% chance for a legendary each kill, meaning that</comment>
				<comment>      the exact chance for getting an item might not be exact to what you</comment>
				<comment>      choose here. Really only a problem if you choose 20%, and then only</comment>
				<comment>      with a couple of enemies in the game with bloated loot pools.</comment>
				<comment>      (Mainly like ... Hyperius)</comment>
				<category name="10% (vanilla)">
					<code profiles="">set GD_Itempools.DropWeights.DropODDS_BossUniques:ConstantAttributeValueResolver_0 ConstantValue 0.100000</code>
				</category>
				<category name="15%">
					<code profiles="default">set GD_Itempools.DropWeights.DropODDS_BossUniques:ConstantAttributeValueResolver_0 ConstantValue 0.150000</code>
				</category>
				<category name="20%">
					<code profiles="">set GD_Itempools.DropWeights.DropODDS_BossUniques:ConstantAttributeValueResolver_0 ConstantValue 0.200000</code>
				</category>
			</category>
			<category name="Global">
				<category name="Increased Enemy Health">
					<code profiles="default">set GD_Balance_HealthAndDamage.HealthAndDamage.Att_BaseEnemyHealth:ConstantAttributeValueResolver_0 ConstantValue 65.000000</code>
					<code profiles="default">set GD_Balance_HealthAndDamage.HealthAndDamage.Att_UniversalAdditionalEnemyHealthPerLvl:ConstantAttributeValueResolver_0 ConstantValue 0.020000</code>
					<comment>clone -x GearboxFramework.Default__ConditionalAttributeValueResolver GD_Balance_HealthAndDamage.HealthAndDamage.Att_BaseEnemyHealth:ConditionalAttributeValueResolver_0</comment>
					<code profiles="default">set GD_Balance_HealthAndDamage.HealthAndDamage.Att_BaseEnemyHealth ValueResolverChain (ConditionalAttributeValueResolver'GD_Balance_HealthAndDamage.HealthAndDamage.Att_BaseEnemyHealth:ConditionalAttributeValueResolver_0')</code>
					<code profiles="default">set GD_Balance_HealthAndDamage.HealthAndDamage.Att_BaseEnemyHealth:ConditionalAttributeValueResolver_0 ValueExpressions (bEnabled=True,ConditionalExpressionList=((BaseValueIfTrue=(BaseValueConstant=65.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=0.714285),Expressions=((AttributeOperand1=AttributeDefinition'D_Attributes.Balance.PlayThroughCount',ComparisonOperator=OPERATOR_EqualTo,Operand2Usage=OPERAND_PreferAttribute,AttributeOperand2=None,ConstantOperand2=2.000000)))),DefaultBaseValue=(BaseValueConstant=65.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=0.833333))</code>
				</category>
				<category name="Reduce Enemy Damage in TVHM+">
					<comment>Compensation for elements in general becoming more powerful in TVHM+</comment>
					<hotfix name="Hotfix" level="None">
						<code profiles="default">set GD_Balance_HealthAndDamage.DamageMultipliers.Init_EnemyDamage_ByPlaythrough_Global ConditionalInitialization (bEnabled=True,ConditionalExpressionList=((BaseValueIfTrue=(BaseValueConstant=1.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000),Expressions=((AttributeOperand1=AttributeDefinition'D_Attributes.Balance.PlayThroughCount',ComparisonOperator=OPERATOR_EqualTo,Operand2Usage=OPERAND_PreferAttribute,AttributeOperand2=None,ConstantOperand2=1.000000))),(BaseValueIfTrue=(BaseValueConstant=0.920000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000),Expressions=((AttributeOperand1=AttributeDefinition'D_Attributes.Balance.PlayThroughCount',ComparisonOperator=OPERATOR_EqualTo,Operand2Usage=OPERAND_PreferAttribute,AttributeOperand2=None,ConstantOperand2=2.000000)))),DefaultBaseValue=(BaseValueConstant=0.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000))</code>
					</hotfix>
				</category>
				<category name="Lower scaling">
					<comment>9% increase per level instead of 13%</comment>
					<code profiles="default">set GD_Balance_HealthAndDamage.HealthAndDamage.Att_UniversalBalanceScaler:ConstantAttributeValueResolver_0 ConstantValue 1.09000</code>
				</category>
