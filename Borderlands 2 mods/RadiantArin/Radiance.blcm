set GD_Mercenary_Skills.Brawn.OrangeOrangutan SkillIcon SwfMovie'UI_Tulip_SharedSkillIcons_Mech.SkillIcon-Mechro02'
set GD_Mercenary_Skills.Brawn.OrangeOrangutan SkillEffectPresentations (AttributePresentationDefinition'GD_Mercenary_Skills.Brawn.OrangeOrangutan:AttributePresentationDefinition_0',AttributePresentationDefinition'GD_Mercenary_Skills.Brawn.OrangeOrangutan:AttributePresentationDefinition_1',AttributePresentationDefinition'GD_Mercenary_Skills.Brawn.OrangeOrangutan:AttributePresentationDefinition_2')
