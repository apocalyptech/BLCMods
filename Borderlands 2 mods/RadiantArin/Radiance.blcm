set GD_Mercenary_Skills.Brawn.OrangeOrangutan:AttributePresentationDefinition_1 Description Max Health: $NUMBER$
set GD_Mercenary_Skills.Brawn.OrangeOrangutan:AttributePresentationDefinition_2 Attribute AttributeDefinition'D_Attributes.DamageSourceModifiers.InstigatedMeleeDamageModifier'
set GD_Mercenary_Skills.Brawn.OrangeOrangutan:AttributePresentationDefinition_2 Description Melee Damage: $NUMBER$
