			<comment>-Credits to Aaron0000 for No More Bullet Reflection below-</comment>
			<category name="No More Enemy Bullet Reflection" locked="true">
				<category name="Description">
					<comment>By Aaron0000</comment>
					<comment>Getting punished for trying to do the thing you're supposed to do sucks. So BEGONE, THOT.</comment>
					<category name="Removes Bullet Reflection from;">
						<comment>Alpha Skags</comment>
						<comment>Anchormen</comment>
						<comment>Badassasaurus</comment>
						<comment>Blue</comment>
						<comment>Boroks</comment>
						<comment>Buccaneer</comment>
						<comment>Bullymong Blocking</comment>
						<comment>Bulstoss</comment>
						<comment>Bulwark</comment>
						<comment>BUL Loaders</comment>
						<comment>Captain Flynt during "fire mode"</comment>
						<comment>Constructor Eye Shields</comment>
						<comment>Craboid Shells</comment>
						<comment>Crabworm Shells</comment>
						<comment>Crawmerax' Shell</comment>
						<comment>Crystallisks</comment>
						<comment>Crystal Skeletons</comment>
						<comment>Dragon Blocking</comment>
						<comment>Dukino's Mom</comment>
						<comment>Golem Blocking</comment>
						<comment>Greedtooth's Shield</comment>
						<comment>Handsome Sorceror's Shield</comment>
						<comment>Hyperius' Shield</comment>
						<comment>Jackenstein</comment>
						<comment>Jack's Surveyor Shield</comment>
						<comment>Knight/Skeleton Shields</comment>
						<comment>Necromancer Shields</comment>
						<comment>OMGWTH</comment>
						<comment>PWR Loaders</comment>
						<comment>Rouge</comment>
						<comment>Savage Fire Shields (presumably Ohmd-Ohmd-Ohk's shield)</comment>
						<comment>Shield Surveyors</comment>
						<comment>Skag Rider Armor</comment>
						<comment>Spiderants</comment>
						<comment>Witch Doctor Tornados</comment>
						<comment>Woundspike</comment>
					</category>
				</category>
				<category name="Code">
					<category name="Badassasaurus">
						<hotfix name="NoBadassasaurusReflect" level="None">
							<code profiles="default">set GD_Truckasaurus.HitRegions.HitRegion_Body bOnlyReflectToAttacker False</code>
							<code profiles="default">set GD_Truckasaurus.HitRegions.HitRegion_Body bReflectProjectiles False</code>
							<code profiles="default">set GD_Truckasaurus.HitRegions.HitRegion_Body bRicochetIfReflectionChanceFails False</code>
							<code profiles="default">set GD_Truckasaurus.HitRegions.HitRegion_Body BulletReflectionOffSelfChance (BaseValueConstant=0.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)</code>
							<code profiles="default">set GD_Truckasaurus.HitRegions.HitRegion_Body BulletReflectedOffSelfDamageScale (BaseValueConstant=1.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)</code>
							<code profiles="default">set GD_Truckasaurus.HitRegions.HitRegion_Body BulletReflectedOffSelfDamageTakenScale (BaseValueConstant=1.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)</code>
							<code profiles="default">set GD_Truckasaurus.HitRegions.HitRegion_Body ReflectionAccuracyModifier (BaseValueConstant=0.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)</code>
