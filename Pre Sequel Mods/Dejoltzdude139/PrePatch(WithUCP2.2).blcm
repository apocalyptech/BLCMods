									</category>
								</category>
								<category name="Prefixes">
									<category name="Shared">
										<code profiles="">set GD_Weap_Shared_Names.Name.Prefix_Vladof.Prefix_Grip_Bandit PartName Noteworthy</code>
										<code profiles="">set GD_Weap_Shared_Names.Name.Prefix_Vladof.Prefix_Grip_Vladof PartName Pearl</code>
										<code profiles="">set GD_Weap_Shared_Names.Name.Prefix_Vladof.Prefix_Grip_Jakobs PartName High-Caliber</code>
