								<category name="Move 00773 Vault Excavation Site next to Cluster 00773 in station list">
									<code profiles="default">set FastTravelStationsListOrder'GD_Ma_FastTravelStations.Ma_StationsList' FastTravelStationOrderList (FastTravelStationDefinition'GD_FastTravelStations.Spaceport',FastTravelStationDefinition'GD_Ma_FastTravelStations.Ma_Deck13_FT',FastTravelStationDefinition'GD_Ma_FastTravelStations.Ma_Nexus_FT',FastTravelStationDefinition'GD_Ma_FastTravelStations.Ma_LeftCluster_FT',FastTravelStationDefinition'GD_Ma_FastTravelStations.Ma_LeftCluster_1way_FT',FastTravelStationDefinition'GD_Ma_FastTravelStations.Ma_RightCluster_FT',FastTravelStationDefinition'GD_Ma_FastTravelStations.Ma_Sub_FT',FastTravelStationDefinition'GD_Ma_FastTravelStations.MA_SubSub_FT',FastTravelStationDefinition'GD_Ma_FastTravelStations.Ma_FinalBoss_FT')</code>
								</category>
								<category name="Re-enable Eye of Helios level transition">
									<hotfix name="EnableLaserBossTravel" level="Laser_P">
										<code profiles="default">set SeqAct_ToggleHidden'Laser_P.TheWorld:PersistentLevel.Main_Sequence.SeqAct_ToggleHidden_1' OutputLinks ()</code>
										<code profiles="default">set SeqAct_ToggleHidden'Laser_P.TheWorld:PersistentLevel.Main_Sequence.SeqAct_ToggleHidden_1' VariableLinks ()</code>
										<code profiles="default">set SeqAct_Toggle'Laser_P.TheWorld:PersistentLevel.Main_Sequence.SeqAct_Toggle_4' OutputLinks ()</code>
										<code profiles="default">set SeqAct_Toggle'Laser_P.TheWorld:PersistentLevel.Main_Sequence.SeqAct_Toggle_4' VariableLinks ()</code>
									</hotfix>
								</category>
								<category name="Respawnable Flameknuckle">
									<hotfix name="RespawnFlame" level="MoonShotIntro_P">
										<code profiles="default">set PopulationOpportunityDen'MoonShotIntro_Dynamic.TheWorld:PersistentLevel.PopulationOpportunityDen_0' IsEnabled True</code>
										<code profiles="default">set PopulationOpportunityDen'MoonShotIntro_Dynamic.TheWorld:PersistentLevel.PopulationOpportunityDen_0' bUseRandomSpawns False</code>
									</hotfix>
								</category>
								<category name="Respawnable Zarpedon">
									<comment>Note that having "Skip Powersuit Phase" selected will spawn both forms during the story,</comment>
									<comment> and that killing Ascended Zarpedon before the objective to do so will cause a softlock</comment>
									<category name="Options" MUT="true">
										<category name="Standard">
											<hotfix name="RespawnZarpMech" level="LaserBoss_P">
												<code profiles="default">set PopulationOpportunityDen'LaserBoss_Boss.TheWorld:PersistentLevel.PopulationOpportunityDen_3' IsEnabled True</code>
												<code profiles="default">set PopulationOpportunityDen'LaserBoss_Boss.TheWorld:PersistentLevel.PopulationOpportunityDen_3' bUseRandomSpawns False</code>
											</hotfix>
										</category>
										<category name="Skip Powersuit Phase">
											<category name="Add Powersuit Drops">
												<hotfix name="RespawnZarp" level="LaserBoss_P">
													<code profiles="">set AIPawnBalanceDefinition'GD_ColZ.Population.PawnBalance_ColZ' DefaultItemPoolList ((ItemPool=ItemPoolDefinition'GD_ItempoolsEnemyUse.Shields.Pool_Shields_Standard_EnemyUse',PoolProbability=(BaseValueConstant=1.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)),(ItemPool=ItemPoolDefinition'GD_Itempools.Runnables.Pool_Tungsteena',PoolProbability=(BaseValueConstant=0.000000,BaseValueAttribute=AttributeDefinition'GD_Itempools.DropWeights.DropODDS_BossUniqueRares',InitializationDefinition=None,BaseValueScaleConstant=1.000000)),(ItemPool=ItemPoolDefinition'GD_ItempoolsEnemyUse.Shields.Pool_Shields_Standard_EnemyUse',PoolProbability=(BaseValueConstant=1.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)),(ItemPool=ItemPoolDefinition'GD_Itempools.Runnables.Pool_ColZarpedon',PoolProbability=(BaseValueConstant=0.000000,BaseValueAttribute=AttributeDefinition'GD_Itempools.DropWeights.DropODDS_BossUniques',InitializationDefinition=None,BaseValueScaleConstant=1.000000)),(ItemPool=KeyedItemPoolDefinition'GD_CustomItemPools_MainGame.Rewards.Head009',PoolProbability=(BaseValueConstant=0.000000,BaseValueAttribute=AttributeDefinition'GD_Itempools.DropWeights.DropODDS_BossUniqueRares',InitializationDefinition=None,BaseValueScaleConstant=1.000000)))</code>
												</hotfix>
											</category>
											<hotfix name="RespawnZarp" level="LaserBoss_P">
												<code profiles="">set PopulationOpportunityDen'LaserBoss_Boss.TheWorld:PersistentLevel.PopulationOpportunityDen_0' IsEnabled True</code>
												<code profiles="">set PopulationOpportunityDen'LaserBoss_Boss.TheWorld:PersistentLevel.PopulationOpportunityDen_0' bUseRandomSpawns False</code>
											</hotfix>
										</category>
									</category>
								</category>
