						<category name="Make Vendors Sell Blue and Purple">
							<category name="makevendorsGreaterAgain">
								<category name="Introduction/Features">
									<comment>###############################################################################################</comment>
									<comment># By Jim Raven                                                                                #</comment>
									<comment># Makes all vendors Great By changing whites to blues and greens to purples                   #</comment>
									<comment># Features                                                                                    #</comment>
									<comment># Weapon vendors Now have a 10% chance at legendary IOTD Else Purple                          #</comment>
									<comment># Health vendors Now have a 10% chance at legendary IOTD Else Purple                          #</comment>
									<comment># Grenade vendors Now have a 10% chance at legendary IOTD Else Purple                         #</comment>
