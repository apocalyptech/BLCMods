				<category name="Running UCP 2.2 BAR">
					<comment>say Running BL TPS UCP 2.2 Check your Badass Rank for a message to confirm everything works as intended</comment>
					<hotfix name="Name" level="None">
						<code profiles="default">set WillowGame.Default__BadassPanelGFxObject TooltipsText_Redeem <font size="26"> <font color="#00FFF2"> Running UCP 2.2 </font> <br></code>
						<code profiles="default">set WillowGame.Default__BadassPanelGFxObject TooltipsText_Close <font size="16"> <StringAliasMap:GFx_Cancel> Close</code>
						<code profiles="default">set WillowGame.Default__BadassPanelGFxObject TooltipsText_ActivateBonusStats <font size="16"> <StringAliasMap:GFx_Accept> Redeem Token &nbsp;&nbsp;&nbsp;&nbsp;<StringAliasMap:GFx_Y> Enable Bonus Stats</code>
						<code profiles="default">set WillowGame.Default__BadassPanelGFxObject TooltipsText_DeactivateBonusStats <font size="16"> <StringAliasMap:GFx_Accept> Redeem Token &nbsp;&nbsp;&nbsp;&nbsp;<StringAliasMap:GFx_Y> Disable Bonus Stats</code>
					</hotfix>
				</category>
			</category>
			<category name="mods">
				<category name="Utilities">
					<category name="Weapon and pickup utilities">
						<category name="More Pick-Up Radius v1.0.0">
							<comment>Mod author: Astor</comment>
							<comment>Release Date: 25 November 2018</comment>
							<comment>Version: 1.0.0 - See ReadMe for Changelog ;)</comment>
							<category name="Description">
								<comment>It's a all simple change but somewhat large, in a sense, change.</comment>
							</category>
							<category name="Choose your Radius (Open to change a option)" MUT="true">
								<category name="Double Pick-Up Radius Range">
									<hotfix name="Hotfix" level="None">
										<code profiles="">set GD_Globals.General.Globals PickupRadius 800.000000</code>
									</hotfix>
								</category>
								<category name="Triple Pick-Up Radius Range">
									<hotfix name="Hotfix" level="None">
										<code profiles="">set GD_Globals.General.Globals PickupRadius 1200.000000</code>
									</hotfix>
								</category>
								<category name="Quintuple Pick-Up Radius Range">
									<hotfix name="Hotfix" level="None">
										<code profiles="default">set GD_Globals.General.Globals PickupRadius 3600.000000</code>
									</hotfix>
								</category>
							</category>
						</category>
						<category name="Lubricated Spinigun Barrels">
							<code profiles="default">set GD_Weap_AssaultRifle.Barrel.AR_Barrel_Vladof_Minigun SpinDownDuration (BaseValueConstant=12.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)</code>
							<code profiles="default">set GD_Weap_AssaultRifle.Barrel.AR_Barrel_Torgue_Vladof SpinDownDuration (BaseValueConstant=12.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)</code>
							<code profiles="default">set gd_cork_weap_assaultrifle.Barrel.AR_Barrel_Vladof_Shredifier SpinDownDuration (BaseValueConstant=12.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)</code>
							<code profiles="default">set gd_cork_weap_assaultrifle.Barrel.AR_Barrel_Vladof_IceScream SpinDownDuration (BaseValueConstant=12.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)</code>
							<code profiles="default">set gd_cork_weap_assaultrifle.Barrel.AR_Barrel_Vladof_OldPainful SpinDownDuration (BaseValueConstant=12.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)</code>
						</category>
						<category name="No More Reload Messages v1.0.0">
							<comment>Mod author: Astor</comment>
							<comment>Release Date: 06 November 2018</comment>
							<comment>Version: 1.0.0 - See ReadMe for Changelog ;)</comment>
							<comment>Removes the "Reload Message" which pop-up (too) often on the screen!</comment>
							<category name="Assault Rifle">
								<code profiles="default">set GD_Weap_AssaultRifle.A_Weapons.WT_Bandit_AssaultRifle bDisableReloadMessages True</code>
								<code profiles="default">set GD_Weap_AssaultRifle.A_Weapons.WT_Dahl_AssaultRifle bDisableReloadMessages True</code>
								<code profiles="default">set GD_Weap_AssaultRifle.A_Weapons.WT_Jakobs_AssaultRifle bDisableReloadMessages True</code>
								<code profiles="default">set GD_Weap_AssaultRifle.A_Weapons.WT_Torgue_AssaultRifle bDisableReloadMessages True</code>
								<code profiles="default">set GD_Weap_AssaultRifle.A_Weapons.WT_Vladof_AssaultRifle bDisableReloadMessages True</code>
							</category>
							<category name="Laser">
								<code profiles="default">set GD_Cork_Weap_Lasers.A_Weapons.WT_Dahl_Laser bDisableReloadMessages True</code>
								<code profiles="default">set GD_Cork_Weap_Lasers.A_Weapons.WT_Hyperion_Laser bDisableReloadMessages True</code>
								<code profiles="default">set GD_Cork_Weap_Lasers.A_Weapons.WT_Maliwan_Laser bDisableReloadMessages True</code>
								<code profiles="default">set GD_Cork_Weap_Lasers.A_Weapons.WT_Tediore_Laser bDisableReloadMessages True</code>
							</category>
							<category name="Launcher">
								<code profiles="default">set GD_Weap_Launchers.A_Weapons.WT_Bandit_Launcher bDisableReloadMessages True</code>
								<code profiles="default">set GD_Weap_Launchers.A_Weapons.WT_Maliwan_Launcher bDisableReloadMessages True</code>
								<code profiles="default">set GD_Weap_Launchers.A_Weapons.WT_Tediore_Launcher bDisableReloadMessages True</code>
								<code profiles="default">set GD_Weap_Launchers.A_Weapons.WT_Torgue_Launcher bDisableReloadMessages True</code>
								<code profiles="default">set GD_Weap_Launchers.A_Weapons.WT_Vladof_Launcher bDisableReloadMessages True</code>
							</category>
							<category name="Pistol">
