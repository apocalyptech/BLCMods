										<code profiles="default">set GD_Cork_Weap_Shotgun.FiringModes.Bullet_Shotgun_Torgemada TimerEvents ((Time=0.010000,Response=(SplitNum=1,SplitAngle=0.000000,SplitAngleOffset=0.000000,SplitDistance=0.000000,SplitFire=FiringModeDefinition'GD_Cork_Weap_Shotgun.FiringModes.Bullet_Shotgun_Torgemada_Child',NewSpeed=0.000000,bDetonate=False,bRespawnTracer=False,bUpdateBeamSourceLocation=False,Behaviors=)),(Time=0.010000,Response=(SplitNum=2,SplitAngle=1.000000,SplitAngleOffset=0.000000,SplitDistance=0.000000,SplitFire=FiringModeDefinition'GD_Cork_Weap_Shotgun.FiringModes.Bullet_Shotgun_Torgemada_Child',NewSpeed=0.000000,bDetonate=False,bRespawnTracer=False,bUpdateBeamSourceLocation=False,Behaviors=)))</code>
