								<code profiles="default">set GD_Cork_Weap_Lasers.FiringModes.Beam_Laser_Maliwan_VibraPulse BeamMaxLength 750000.000000</code>
								<code profiles="default">set GD_Cork_Weap_Lasers.FiringModes.Beam_Laser_Maliwan_VibraPulse BeamChainMaxDistance 400000.000000</code>
								<code profiles="default">set GD_Cork_Weap_Lasers.FiringModes.Bullet_Laser_Maliwan_SavorySideSaber BeamMaxLockOnDistance 5500.000000</code>
								<code profiles="default">set GD_Cork_Weap_Lasers.FiringModes.Bullet_Laser_Maliwan_SavorySideSaber BeamMaxLength 5500.000000</code>
								<code profiles="default">set GD_Cork_Weap_Lasers.FiringModes.Bullet_Laser_Maliwan_SavorySideSaber BeamChainMaxDistance 20000.000000</code>
