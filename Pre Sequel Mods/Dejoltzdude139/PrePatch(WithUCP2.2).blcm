								</category>
								<category name="FiringModes">
									<code profiles="default">set gd_cork_weap_assaultrifle.Barrel.AR_Barrel_Jakobs_Wallop CustomFiringModeDefinition FiringModeDefinition'GD_Cork_Weap_Shotgun.FiringModes.Bullet_Shotgun_Torgemada'</code>
									<category name="Main Bullet">
										<code profiles="default">set GD_Cork_Weap_Shotgun.FiringModes.Bullet_Shotgun_Torgemada DamageTypeDefinition none</code>
										<code profiles="default">set GD_Cork_Weap_Shotgun.FiringModes.Bullet_Shotgun_Torgemada PartSysTemplate ParticleSystem'FX_WEP_Trails.Particles.Part_Wep_Tracer_Default'</code>
