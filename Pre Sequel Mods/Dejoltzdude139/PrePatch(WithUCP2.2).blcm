						<category name="Refill Ammo Vendors">
							<category name="Introduction">
								<comment>####################################################################################################</comment>
								<comment># By Jim Raven                                                                                     #</comment>
								<comment># Makes Ammo Vendors Refill your Ammo Fully!                                                       #</comment>
								<comment># Example you buy One Sniper Ammo from vendor when you have 0 ammo now you are full                #</comment>
								<comment># Install WIth Filter Tool Unless you know how to Merge hotfixes yourself                          #</comment>
								<comment># Everything is editable and categorised as such for an easier Customazability to your own needs.  #</comment>
								<comment>####################################################################################################</comment>
							</category>
							<category name="Assault Rifle">
								<hotfix name="RefillVendors" level="None">
									<code profiles="default">set GD_Ammodrops.AmmoPickup_Amounts.AmmoAmountShop_CombatRifle:ConstantAttributeValueResolver_0 ConstantValue 9999.000000</code>
									<code profiles="default">set GD_Ammodrops.Shop.AmmoShop_Assault_Rifle_Bullets:AttributePresentationDefinition_0 Description Completely Refill your Assault Rifle bullets.</code>
								</hotfix>
							</category>
							<category name="Grenades">
								<hotfix name="RefillVendors" level="None">
									<code profiles="default">set GD_Ammodrops.AmmoPickup_Amounts.AmmoAmountShop_Grenades:ConstantAttributeValueResolver_1 ConstantValue 9999.000000</code>
									<code profiles="default">set GD_Ammodrops.Shop.AmmoShop_Grenade_Protean:AttributePresentationDefinition_2 Description Completely Refill your Grenades.</code>
								</hotfix>
							</category>
							<category name="Lasers">
								<hotfix name="RefillVendors" level="None">
									<code profiles="default">set GD_Ammodrops.AmmoPickup_Amounts.AmmoAmountShop_Laser:ConstantAttributeValueResolver_5 ConstantValue 9999.000000</code>
									<code profiles="default">set GD_Ammodrops.Shop.AmmoShop_Laser_Cells:AttributePresentationDefinition_1 Description Completely Refill your Laser Cells.</code>
								</hotfix>
							</category>
							<category name="Launchers">
								<hotfix name="RefillVendors" level="None">
									<code profiles="default">set GD_Ammodrops.AmmoPickup_Amounts.AmmoAmountShop_Launcher:ConstantAttributeValueResolver_2 ConstantValue 9999.000000</code>
									<code profiles="default">set GD_Ammodrops.Shop.AmmoShop_Rocket_Launcher:AttributePresentationDefinition_6 Description Completely Refill your rockets for Launchers.</code>
								</hotfix>
							</category>
							<category name="Pistols">
								<hotfix name="RefillVendors" level="None">
									<code profiles="default">set GD_Ammodrops.AmmoPickup_Amounts.AmmoAmountShop_Repeater:ConstantAttributeValueResolver_4 ConstantValue 9999.000000</code>
									<code profiles="default">set GD_Ammodrops.Shop.AmmoShop_Repeater_Pistol_Clip:AttributePresentationDefinition_4 Description Completely Refill your Pistol bullets.</code>
								</hotfix>
							</category>
							<category name="SMG">
								<hotfix name="RefillVendors" level="None">
									<code profiles="default">set GD_Ammodrops.AmmoPickup_Amounts.AmmoAmountShop_SMG:ConstantAttributeValueResolver_3 ConstantValue 9999.000000</code>
									<code profiles="default">set GD_Ammodrops.Shop.AmmoShop_Patrol_SMG_Clip:AttributePresentationDefinition_3 Description Completely Refill your SMG bullets.</code>
								</hotfix>
							</category>
							<category name="Shotgun">
								<hotfix name="RefillVendors" level="None">
									<code profiles="default">set GD_Ammodrops.AmmoPickup_Amounts.AmmoAmountShop_Shotgun:ConstantAttributeValueResolver_5 ConstantValue 9999.000000</code>
									<code profiles="default">set GD_Ammodrops.Shop.AmmoShop_Shotgun_Shells:AttributePresentationDefinition_1 Description Completely Refill your Shotgun shells.</code>
								</hotfix>
							</category>
							<category name="Sniper Rifle">
