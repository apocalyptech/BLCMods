					<category name="Elemental Melee (imported from elemelee.blcm)">
						<comment>This little mod allows you to change the element of your melee attacks, so you can go totally krazy with your melle zero or melee krieg builds. Have fun</comment>
						<category name="Options">
							<category name="Bladed" MUT="true">
								<category name="Normal">
									<comment>lmfao, why is this empty</comment>
								</category>
								<category name="Ice">
									<hotfix name="Name" level="None">
										<code profiles="">set GD_PlayerShared.Behaviors.BehaviorData_PlayerMeleeAttackWithBladedWeapon DamageTypeDefinition WillowDamageTypeDefinition'GD_Ice.DamageType.DmgType_Ice_Impact'</code>
