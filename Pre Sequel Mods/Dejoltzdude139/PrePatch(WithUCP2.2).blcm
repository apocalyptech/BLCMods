						<category name="88.89% Less Luneshine">
							<comment><88.89% Less Luneshine></comment>
							<comment>by Kazy</comment>
							<comment>This mod decreases the Luneshine brightness (and nothing more about Luneshine) by a whopping 88.89%!</comment>
							<comment>Now you won't feel like you're staring into the sun while holding a Luneshine weapon.</comment>
							<comment><Coding></comment>
							<code profiles="default">set GD_Weap_Accessories.Moonstone.Moonstone_Attachment_Boominator MaterialScalerParameterValues ((ParameterName="p_MoonstoneOverlay",ParameterValue=0.170000,ExpressionGUID=(A=0,B=0,C=0,D=1)))</code>
							<code profiles="default">set GD_Weap_Accessories.Moonstone.Moonstone_Attachment_FastLearner MaterialScalerParameterValues ((ParameterName="p_MoonstoneOverlay",ParameterValue=0.170000,ExpressionGUID=(A=0,B=0,C=0,D=1)))</code>
							<code profiles="default">set GD_Weap_Accessories.Moonstone.Moonstone_Attachment_HardenUp MaterialScalerParameterValues ((ParameterName="p_MoonstoneOverlay",ParameterValue=0.170000,ExpressionGUID=(A=0,B=0,C=0,D=1)))</code>
							<code profiles="default">set GD_Weap_Accessories.Moonstone.Moonstone_Attachment_Oxygenator MaterialScalerParameterValues ((ParameterName="p_MoonstoneOverlay",ParameterValue=0.170000,ExpressionGUID=(A=0,B=0,C=0,D=1)))</code>
							<code profiles="default">set GD_Weap_Accessories.Moonstone.Moonstone_Attachment_PiercingRounds MaterialScalerParameterValues ((ParameterName="p_MoonstoneOverlay",ParameterValue=0.170000,ExpressionGUID=(A=0,B=0,C=0,D=1)))</code>
							<code profiles="default">set GD_Weap_Accessories.Moonstone.Moonstone_Attachment_Punisher MaterialScalerParameterValues ((ParameterName="p_MoonstoneOverlay",ParameterValue=0.170000,ExpressionGUID=(A=0,B=0,C=0,D=1)))</code>
							<code profiles="default">set GD_Weap_Accessories.Moonstone.Moonstone_Attachment_Safeguard MaterialScalerParameterValues ((ParameterName="p_MoonstoneOverlay",ParameterValue=0.170000,ExpressionGUID=(A=0,B=0,C=0,D=1)))</code>
							<code profiles="default">set GD_Weap_Accessories.Moonstone.Moonstone_Attachment_Serenity MaterialScalerParameterValues ((ParameterName="p_MoonstoneOverlay",ParameterValue=0.170000,ExpressionGUID=(A=0,B=0,C=0,D=1)))</code>
							<comment></Coding></comment>
							<comment></88.89% Less Luneshine></comment>
						</category>
