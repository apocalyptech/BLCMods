						<category name="Fast Travel Portal Disabler ">
							<category name="Description">
								<comment># Mod by FromDarkHell</comment>
								<comment># This mod disables the fast travel 'portal' like animation</comment>
								<comment>#    </comment>
								<comment># Gif of the mod in action: https://gfycat.com/HarshSmoggyHochstettersfrog</comment>
							</category>
							<category name="Code">
								<category name="Hotfixes">
									<hotfix name="TravelPortalDisabler" level="None">
										<code profiles="default">set Loader.TheWorld:PersistentLevel.HoldingAreaDestination_1 ExitPointsCounter -99</code>
									</hotfix>
								</category>
							</category>
						</category>
