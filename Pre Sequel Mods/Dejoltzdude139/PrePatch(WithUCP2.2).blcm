				<category name="Customs">
					<category name="WeaponMods">
						<category name="Assault">
							<category name="Bekah-Breaks Torgumenda-Makes it a Bekah Shotgun">
								<category name="Info">
									<comment>#by Laxlife</comment>
									<comment>#Replaces the Wallop, and turns it into one of the most powerful guns in BL2 -- The Bekah</comment>
									<comment>#Breaks the Torgemada Shotgun. Turns it into a shotgun bekah, becuase I used its FiringModes.</comment>
								</category>
								<category name="Card">
									<code profiles="default">set gd_cork_weap_assaultrifle.Name.Title_Jakobs.Title_Unique_Wallop PartName Bekah</code>
									<code profiles="default">set gd_cork_weap_assaultrifle.Name.Title_Jakobs.Title_Unique_Wallop:AttributePresentationDefinition_8 NoConstraintText Shoot them in the face. Twice.</code>
									<code profiles="default">set gd_cork_weap_assaultrifle.Barrel.AR_Barrel_Jakobs_Wallop WeaponCardAttributes ()</code>
									<code profiles="default">set gd_cork_weap_assaultrifle.Barrel.AR_Barrel_Jakobs_Wallop rarity (BaseValueConstant=501.000000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)</code>
								</category>
								<category name="Attributes">
									<code profiles="default">set gd_cork_weap_assaultrifle.Barrel.AR_Barrel_Jakobs_Wallop WeaponAttributeEffects ((AttributeToModify=AttributeDefinition'D_Attributes.Weapon.WeaponDamage',ModifierType=MT_Scale,BaseModifierValue=(BaseValueConstant=0.300000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)),(AttributeToModify=AttributeDefinition'D_Attributes.Weapon.WeaponPerShotAccuracyImpulse',ModifierType=MT_Scale,BaseModifierValue=(BaseValueConstant=-0.500000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)))</code>
									<code profiles="default">set gd_cork_weap_assaultrifle.Barrel.AR_Barrel_Jakobs_Wallop ExternalAttributeEffects ((AttributeToModify=AttributeDefinition'D_Attributes.GameplayAttributes.PlayerCriticalHitBonus',ModifierType=MT_Scale,BaseModifierValue=(BaseValueConstant=0.500000,BaseValueAttribute=None,InitializationDefinition=None,BaseValueScaleConstant=1.000000)))</code>
									<code profiles="default">set gd_cork_weap_assaultrifle.Barrel.AR_Barrel_Jakobs_Wallop AttributeSlotUpgrades ((SlotName="WeaponSpread",GradeIncrease=-3,bActivateSlot=True),(SlotName="AccuracyMin",GradeIncrease=-3,bActivateSlot=True),(SlotName="WeaponDamage",GradeIncrease=2,bActivateSlot=True))</code>
								</category>
								<category name="Barrel">
									<code profiles="default">set gd_cork_weap_assaultrifle.Barrel.AR_Barrel_Jakobs_Wallop GestaltModeSkeletalMeshName AR_Barrel_Bandit</code>
